# Base URL of the Orbit backend. The API client appends `/api/v1`.
VITE_API_BASE_URL=http://localhost:8080

# Clerk publishable key (frontend auth). See T-FND-BE-3.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional: inject a dev JWT to bypass Clerk while developing auth routes.
# When set, AuthProvider treats the session as authenticated.
# VITE_DEV_JWT=
