# Discovery prototype — environment template.
# Copy to `.env` and fill in. The real `.env` is gitignored and NOT submitted.

# --- PostgreSQL (pgvector) on localhost:5432 ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=badenconnect
DB_USER=root
DB_PASSWORD=

# --- Embeddings (local Ollama) ---
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=jeffh/intfloat-multilingual-e5-large:f16

# --- Optional: lazy cited rationale (search/ingest degrade gracefully without it) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
RATIONALE_MODEL=gemini-2.5-flash-lite

# --- Optional: synthetic-profile generation (archive/00) and GitHub ingestion ---
ANTHROPIC_API_KEY=
GITHUB_PAT=

# --- Optional tuning ---
PAGE_SIZE=5
INGEST_SUMMARY=1
